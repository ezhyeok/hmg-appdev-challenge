<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- 쉼표가 쓰는 권한. 제출 전에 실제로 쓰는 것만 남긴다 -->
    <!-- Vehicle SDK: 조회(CAR_*)와 제어(CONTROL_CAR_*) -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- NaviHelper -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 음성, 위치(FUSED_LOCATION은 실행 중 요청) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Pleos LLM SDK (ON_DEVICE 모드 확인용) -->
    <uses-permission android:name="pleos.car.permission.LLM_SERVICE" />
    <!-- AAOS 표준 Car API: 기어(normal), 차속(실행 중 요청) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ShimpyoApp"
        android:allowBackup="false"
        android:label="쉼표"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- CCP(로터리) 미지원 선언 (CCP 개발 가이드 'CCP 미지원 선언 방법'). 사용자 설치 앱은 CCP 지원이 선택이고, 미지원이면
             필수 조작을 터치만으로 끝낼 수 있어야 한다(쉼표는 모든 조작이 터치로 된다). 기본 포커스·포커스 순서·팝업 포커스 가두기는
             넣었지만 CCP UX 가이드 심사 항목 전체를 실제 CCP로 확인하지 못했으므로 지원한다고 선언하지 않는다.
             CCP Back(뒤로)에서 최상위 화면이면 moveTaskToBack(true)로 숨기는 필수 정책은 지킨다(ShimpyoContent) -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 화면을 유지한다. 주행 중 조작 제한은 화면이 CarUxRestrictions를 직접 구독해 지킨다(UiRestrictions, 모르면 제한) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <service
            android:name=".coach.CoachService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps restroom and fatigue estimation running while driving (vehicle and navigation listeners)" />
        </service>
    </application>
</manifest>
